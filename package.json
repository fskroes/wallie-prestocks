{
  "name": "wallie-prestocks",
  "version": "0.1.0",
  "private": true,
  "description": "A Wallie agent that watches PreStocks (tokenized pre-IPO stocks on Solana), pays per report over x402, and buys under a spending limit it cannot exceed.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "demo": "node demo/run.ts",
    "cli": "node src/cli.ts"
  },
  "dependencies": {
    "@solana/kit": "^5.5.1",
    "@solana/web3.js": "^1.99.0",
    "@x402/svm": "^2.25.0",
    "allowance-kit": "^0.7.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "typescript": "^5.9.3"
  }
}
